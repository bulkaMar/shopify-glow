<section class="page-width py-14 md:py-20">
  {%- if section.settings.heading != blank -%}
    <h2 class="mb-10 text-center text-3xl md:text-4xl" data-reveal>{% render 'tr', text: section.settings.heading %}</h2>
  {%- endif -%}

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tint_index = forloop.index0 | modulo: 2
        if tint_index == 0
          assign tint = 'bg-soft'
          assign icon_color = 'text-accent'
        else
          assign tint = 'bg-blush/70'
          assign icon_color = 'text-pink'
        endif
      -%}
      <div style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 100 }}ms" data-reveal {{ block.shopify_attributes }}>
        <div class="group relative isolate h-full overflow-hidden rounded-3xl {{ tint }} p-7 transition duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-ink/5">
          <span class="pointer-events-none absolute -right-8 -bottom-8 -z-10 {{ icon_color }} opacity-10 transition duration-700 group-hover:scale-110 group-hover:-rotate-12">
            {% render 'icon', name: block.settings.icon, class: 'size-40' %}
          </span>

          <div class="flex items-start justify-between">
            <span class="flex size-14 items-center justify-center rounded-2xl bg-paper {{ icon_color }} shadow-sm transition duration-500 group-hover:scale-110 group-hover:rotate-6">
              {% render 'icon', name: block.settings.icon, class: 'size-7' %}
            </span>
            <span class="font-heading text-sm text-ink/30 tabular-nums">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          </div>

          <h3 class="mt-10 text-xl">{% render 'tr', text: block.settings.title %}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/70">{% render 'tr', text: block.settings.text %}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "rabbit", "label": "Rabbit" },
            { "value": "flask", "label": "Flask" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "sun", "label": "Sun" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean ingredients"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "No parabens, sulfates or fragrance"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": { "icon": "leaf", "title": "Clean ingredients", "text": "No parabens, sulfates or fragrance" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "rabbit", "title": "Cruelty-free", "text": "Never tested on animals" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "flask", "title": "Dermatologist tested", "text": "Safe for sensitive skin" }
        },
        {
          "type": "benefit",
          "settings": { "icon": "recycle", "title": "Recyclable packaging", "text": "Glass bottles and paper boxes" }
        }
      ]
    }
  ]
}
{% endschema %}
