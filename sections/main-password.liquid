<div class="flex min-h-screen flex-col items-center justify-center bg-soft/60 px-4 py-16 text-center">
  <p>{% render 'logo', id: 'password', class: 'text-4xl' %}</p>

  <p class="eyebrow mt-16">{{ 'password.opening_soon' | t }}</p>
  <h1 class="mt-4 max-w-2xl text-5xl leading-tight md:text-6xl">{% render 'tr', text: section.settings.heading %}</h1>
  <p class="mt-4 max-w-md text-ink/70">{% render 'tr', text: section.settings.text %}</p>

  {% render 'newsletter-form', form_id: 'NewsletterPassword', class: 'mt-8 w-full max-w-md' %}

  <details class="mt-16">
    <summary class="cursor-pointer list-none text-sm underline underline-offset-4">{{ 'password.enter_store' | t }}</summary>
    {%- form 'storefront_password', class: 'mt-4 flex gap-2' -%}
      <label for="Password" class="sr-only">{{ 'password.password' | t }}</label>
      <input
        id="Password"
        type="password"
        name="password"
        class="input"
        placeholder="{{ 'password.password' | t }}"
        autocomplete="current-password"
        required
      >
      <button type="submit" class="btn-outline shrink-0">{{ 'password.enter' | t }}</button>
      {%- if form.errors -%}
        <p class="text-sm text-accent" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something glowing is coming"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Be the first to know when we launch and get 10% off your first order."
    }
  ]
}
{% endschema %}
