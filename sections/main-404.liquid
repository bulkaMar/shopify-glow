<div class="page-width flex flex-col items-center py-24 text-center md:py-32">
  <p class="font-heading text-8xl text-accent">404</p>
  <h1 class="mt-4 text-3xl md:text-4xl">{{ 'not_found.title' | t }}</h1>
  <p class="mt-3 text-ink/70">{{ 'not_found.text' | t }}</p>
  <a href="{{ routes.all_products_collection_url }}" class="btn mt-8">{{ 'cart.continue' | t }}</a>
</div>

{% schema %}
{
  "name": "404",
  "enabled_on": {
    "templates": ["404"]
  }
}
{% endschema %}
