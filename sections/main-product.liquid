{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}

<section class="page-width grid gap-10 py-8 md:grid-cols-2 md:gap-16 md:py-14" data-product>
  <div class="md:sticky md:top-28 md:self-start">
    <div class="aspect-square overflow-hidden rounded-3xl bg-soft" data-main-media>
      {%- assign main_media = current_variant.featured_media | default: product.featured_media -%}
      {%- if main_media -%}
        {{
          main_media
          | image_url: width: 1400
          | image_tag:
            class: 'h-full w-full object-cover',
            widths: '600, 900, 1200, 1400',
            sizes: '(min-width: 768px) 50vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            data-main-image: ''
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'h-full w-full' }}
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="mt-4 flex gap-3 overflow-x-auto pb-1">
        {%- for media in product.media limit: 8 -%}
          {%- if media.media_type == 'image' -%}
            <button
              type="button"
              class="size-20 shrink-0 cursor-pointer overflow-hidden rounded-xl border-2 border-transparent bg-soft transition hover:border-accent aria-[current=true]:border-ink"
              data-thumb="{{ media | image_url: width: 1400 }}"
              aria-current="{% if media.id == main_media.id %}true{% else %}false{% endif %}"
              aria-label="{{ media.alt | default: product.title | escape }}"
            >
              {{ media | image_url: width: 160 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy' }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="flex flex-col gap-6">
    <div>
      {%- if product.type != blank -%}
        <p class="eyebrow mb-2">{{ product.type }}</p>
      {%- endif -%}
      <h1 class="text-4xl leading-tight md:text-5xl">{{ product.title }}</h1>

      {%- assign product_rating = product.metafields.reviews.rating.value -%}
      {%- if product_rating -%}
        <a href="#reviews" class="mt-3 inline-flex text-sm hover:text-accent">
          {% render 'rating-stars', rating: product_rating.rating, max: product_rating.scale_max, count: product.metafields.reviews.rating_count.value %}
        </a>
      {%- endif -%}

      <div class="mt-4 flex items-center gap-3 text-xl">
        <span data-price>{{ current_variant.price | money }}</span>
        <s
          class="text-base text-ink/50"
          data-compare-price
          {% unless current_variant.compare_at_price > current_variant.price %}
            hidden
          {% endunless %}
        >
          {{- current_variant.compare_at_price | money -}}
        </s>
      </div>
    </div>

    {%- liquid
      assign product_benefits = product.metafields.custom.benefits.value
      assign product_benefits_shown = false
    -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'tagline' -%}
          {%- if block.settings.text != blank -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endif -%}

        {%- when 'skin_types' -%}
          {%- liquid
            assign skin_keys = 'dry,normal,oily,combination,sensitive' | split: ','
            assign tagged_types = ''
            for key in skin_keys
              assign skin_tag = key | append: ' skin'
              if product.tags contains skin_tag
                assign tagged_types = tagged_types | append: key | append: ','
              endif
            endfor

            if tagged_types != blank
              assign skin_types = tagged_types | split: ','
            else
              assign skin_types = ''
              for key in skin_keys
                if block.settings[key]
                  assign skin_types = skin_types | append: key | append: ','
                endif
              endfor
              assign skin_types = skin_types | split: ','
            endif
          -%}
          {%- if skin_types.size > 0 -%}
            <div {{ block.shopify_attributes }}>
              <p class="mb-2 text-sm font-medium">{{ 'products.suitable_for' | t }}</p>
              <ul class="flex flex-wrap gap-2">
                {%- for key in skin_types -%}
                  {%- assign skin_key = 'skin_types.' | append: key -%}
                  <li class="rounded-full bg-blush px-4 py-1.5 text-sm">{{ skin_key | t }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

        {%- when 'benefit' -%}
          {%- if product_benefits.size > 0 -%}
            {%- unless product_benefits_shown -%}
              {%- assign product_benefits_shown = true -%}
              <ul class="flex flex-col gap-4" {{ block.shopify_attributes }}>
                {%- for benefit in product_benefits limit: 5 -%}
                  <li class="flex items-center gap-3 text-sm">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-soft text-accent">
                      {%- assign benefit_icon = 'droplet,leaf,sparkle,heart,shield' | split: ',' -%}
                      {% render 'icon', name: benefit_icon[forloop.index0] %}
                    </span>
                    {{ benefit }}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endunless -%}
          {%- else -%}
            <div class="flex items-center gap-3 text-sm" {{ block.shopify_attributes }}>
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-soft text-accent">
                {% render 'icon', name: block.settings.icon %}
              </span>
              {%- if block.settings.preset == 'custom' -%}
                {{ block.settings.text }}
              {%- else -%}
                {%- assign benefit_key = 'benefits.' | append: block.settings.preset -%}
                {{ benefit_key | t }}
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'buy_buttons' -%}
          <div {{ block.shopify_attributes }}>
            {%- form 'product', product, id: product_form_id, data-product-form: '' -%}
              {% render 'variant-picker', product: product, current_variant: current_variant, low_stock_threshold: block.settings.low_stock_threshold %}

              {%- liquid
                assign low_stock = ''
                if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_stock_threshold
                  assign low_stock = 'products.low_stock' | t: count: current_variant.inventory_quantity
                endif
              -%}
              <p
                class="mb-4 flex items-center gap-2 text-sm font-semibold text-pink"
                data-low-stock
                {% if low_stock == blank %}
                  hidden
                {% endif %}
              >
                <span class="relative flex size-2.5">
                  <span class="absolute inline-flex size-full animate-ping rounded-full bg-pink opacity-60"></span>
                  <span class="relative inline-flex size-2.5 rounded-full bg-pink"></span>
                </span>
                <span data-low-stock-text>{{ low_stock }}</span>
              </p>

              <div class="flex gap-3">
                <div class="flex items-center rounded-full border border-ink/20">
                  <button
                    type="button"
                    class="flex size-10 cursor-pointer items-center justify-center rounded-full transition hover:bg-soft"
                    data-quantity-step="down"
                    aria-label="{{ 'cart.decrease' | t }}"
                  >
                    {% render 'icon', name: 'minus', class: 'size-4' %}
                  </button>
                  <input
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' %}
                      max="{{ current_variant.inventory_quantity }}"
                    {% endif %}
                    class="w-7 bg-transparent text-center text-sm [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none"
                    aria-label="{{ 'products.quantity' | t }}"
                  >
                  <button
                    type="button"
                    class="flex size-10 cursor-pointer items-center justify-center rounded-full transition hover:bg-soft"
                    data-quantity-step="up"
                    aria-label="{{ 'cart.increase' | t }}"
                  >
                    {% render 'icon', name: 'plus', class: 'size-4' %}
                  </button>
                </div>

                <button
                  type="submit"
                  class="btn flex-1 py-3"
                  data-add-button
                  data-add-text="{{ 'products.add_to_cart' | t | escape }}"
                  data-sold-out-text="{{ 'products.sold_out' | t | escape }}"
                  {% unless current_variant.available %}
                    disabled
                  {% endunless %}
                >
                  {%- if current_variant.available -%}
                    {{ 'products.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </button>
              </div>

              <p class="mt-3 rounded-xl bg-soft p-3 text-sm" role="alert" data-form-error hidden></p>

              {%- if block.settings.show_payment_button -%}
                <div class="mt-3">{{ form | payment_button }}</div>
              {%- endif -%}
            {%- endform -%}
          </div>

        {%- when 'accordion' -%}
          {%- liquid
            case block.settings.source
              when 'description'
                assign accordion_content = product.description
              when 'ingredients'
                assign accordion_content = product.metafields.custom.ingredients | metafield_tag
              when 'how_to_use'
                assign accordion_content = product.metafields.custom.how_to_use | metafield_tag
              else
                assign accordion_content = ''
            endcase
            if accordion_content == blank
              assign accordion_content = block.settings.content
            endif

            if block.settings.heading_preset == 'custom'
              assign accordion_heading = block.settings.heading
            else
              assign heading_key = 'products.' | append: block.settings.heading_preset
              assign accordion_heading = heading_key | t
            endif
          -%}
          {%- if accordion_content != blank -%}
            <details
              class="group border-b border-ink/15 py-4"
              {% if block.settings.open %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between font-medium">
                {{ accordion_heading }}
                <span class="transition group-open:rotate-45">{% render 'icon', name: 'plus' %}</span>
              </summary>
              <div class="rte pt-3 text-sm">{{ accordion_content }}</div>
            </details>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
  <div
    class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-ink/10 bg-paper/95 shadow-[0_-8px_30px_rgb(0_0_0/0.06)] backdrop-blur transition duration-500 data-visible:translate-y-0"
    data-sticky-cart
    inert
  >
    <div class="page-width flex items-center gap-4 py-3">
      <div class="hidden size-12 shrink-0 overflow-hidden rounded-xl bg-soft sm:block">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 120 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy' }}
        {%- endif -%}
      </div>
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium">{{ product.title }}</p>
        <p class="text-sm text-ink/60" data-sticky-price>{{ current_variant.price | money }}</p>
      </div>
      <button
        type="submit"
        form="{{ product_form_id }}"
        class="btn shrink-0 px-6 py-3"
        data-sticky-add
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        {%- if current_variant.available -%}
          {{ 'products.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.sold_out' | t }}
        {%- endif -%}
      </button>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "tagline",
      "name": "Tagline",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A lightweight serum that hydrates and brightens your skin.</p>"
        }
      ]
    },
    {
      "type": "skin_types",
      "name": "Skin types",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Products tagged \"dry skin\", \"oily skin\", etc. show their own skin types. Otherwise these are used:"
        },
        { "type": "checkbox", "id": "dry", "label": "Dry", "default": true },
        { "type": "checkbox", "id": "normal", "label": "Normal", "default": true },
        { "type": "checkbox", "id": "oily", "label": "Oily", "default": false },
        { "type": "checkbox", "id": "combination", "label": "Combination", "default": false },
        { "type": "checkbox", "id": "sensitive", "label": "Sensitive", "default": true }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "sun", "label": "Sun" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "rabbit", "label": "Rabbit" },
            { "value": "flask", "label": "Flask" },
            { "value": "recycle", "label": "Recycle" }
          ],
          "default": "droplet"
        },
        {
          "type": "select",
          "id": "preset",
          "label": "Text",
          "info": "Ready-made texts are translated automatically",
          "options": [
            { "value": "hydration", "label": "Deep hydration for 24 hours" },
            { "value": "vegan", "label": "Vegan and cruelty-free" },
            { "value": "glow", "label": "Visible glow in 2 weeks" },
            { "value": "brightening", "label": "Brighter, more even skin tone" },
            { "value": "soothing", "label": "Calms redness and irritation" },
            { "value": "barrier", "label": "Strengthens the skin barrier" },
            { "value": "clear", "label": "Helps clear breakouts" },
            { "value": "anti_aging", "label": "Smooths fine lines" },
            { "value": "fragrance_free", "label": "Fragrance-free formula" },
            { "value": "custom", "label": "Custom text" }
          ],
          "default": "hydration"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Custom text"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_payment_button",
          "label": "Show dynamic checkout button",
          "default": false
        },
        {
          "type": "range",
          "id": "low_stock_threshold",
          "label": "Show low stock message at",
          "info": "Shows \"Only X left\" when stock is at or below this number",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 5
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "select",
          "id": "heading_preset",
          "label": "Heading",
          "options": [
            { "value": "description", "label": "Description" },
            { "value": "ingredients", "label": "Key ingredients" },
            { "value": "how_to_use", "label": "How to use" },
            { "value": "custom", "label": "Custom heading" }
          ],
          "default": "how_to_use"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Custom heading"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content",
          "options": [
            { "value": "description", "label": "Product description" },
            { "value": "ingredients", "label": "Product metafield: custom.ingredients" },
            { "value": "how_to_use", "label": "Product metafield: custom.how_to_use" },
            { "value": "content", "label": "Text below" }
          ],
          "default": "how_to_use"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text",
          "info": "Used when the product has no metafield value. The block hides when empty."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
