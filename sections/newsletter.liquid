<section class="page-width py-14 md:py-20">
  <div class="relative isolate overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-soft to-blush/70 px-6 py-14 text-center md:px-16" data-reveal>
    <div class="blob pointer-events-none absolute -top-20 -right-10 -z-10 size-72 rounded-full bg-paper/50 blur-3xl"></div>
    <h2 class="text-3xl md:text-4xl">{% render 'tr', text: section.settings.heading %}</h2>
    <p class="mx-auto mt-3 max-w-md text-ink/70">{% render 'tr', text: section.settings.text %}</p>
    {% render 'newsletter-form', form_id: 'NewsletterSection', class: 'mx-auto mt-8 max-w-md' %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Join our newsletter for skincare tips, new launches and exclusive offers."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
