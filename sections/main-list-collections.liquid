<div class="page-width py-10 md:py-16">
  <h1 class="mb-10 text-center text-4xl md:text-5xl">{% render 'tr', text: section.settings.heading %}</h1>

  <div class="grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6">
    {%- for item in collections -%}
      <a href="{{ item.url }}" class="group block">
        <div class="aspect-square overflow-hidden rounded-3xl bg-soft">
          {%- assign image = item.featured_image | default: item.products.first.featured_media -%}
          {%- if image -%}
            {{
              image
              | image_url: width: 800
              | image_tag:
                class: 'h-full w-full object-cover transition duration-700 group-hover:scale-105',
                widths: '400, 600, 800',
                sizes: '(min-width: 768px) 33vw, 50vw',
                loading: 'lazy'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'h-full w-full' }}
          {%- endif -%}
        </div>
        <h2 class="mt-4 text-xl group-hover:text-accent">{{ item.title }}</h2>
        <p class="text-sm text-ink/60">{{ 'collection.product_count' | t: count: item.products_count }}</p>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ]
}
{% endschema %}
