{%- if section.settings.text != blank -%}
  <div class="bg-soft px-4 py-2.5 text-center text-xs tracking-wide text-ink">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="underline-offset-4 hover:underline">{% render 'tr', text: section.settings.text %}</a>
    {%- else -%}
      {% render 'tr', text: section.settings.text %}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on orders over $50 ✨"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
