<div class="page-width py-10 md:py-16" data-cart-page>
  <h1 class="text-4xl md:text-5xl">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="mt-10 grid gap-10 lg:grid-cols-[1fr_380px]">
      <ul class="divide-y divide-ink/10 border-y border-ink/10">
        {%- for item in cart.items -%}
          {%- liquid
            assign max_quantity = nil
            if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
              assign max_quantity = item.variant.inventory_quantity
            endif
          -%}
          <li class="flex gap-4 py-6 transition-opacity md:gap-6" data-cart-page-item>
            <a href="{{ item.url }}" class="size-24 shrink-0 overflow-hidden rounded-2xl bg-soft md:size-32">
              {%- if item.image -%}
                {{ item.image | image_url: width: 256 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy' }}
              {%- endif -%}
            </a>

            <div class="flex flex-1 flex-col gap-1">
              <a href="{{ item.url }}" class="font-medium hover:text-accent">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="text-sm text-ink/60">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p class="text-sm">{{ item.final_price | money }}</p>

              <div class="mt-auto flex items-center gap-4 pt-3">
                <label for="Quantity-{{ forloop.index }}" class="sr-only">{{ 'products.quantity' | t }}</label>
                <div class="flex items-center rounded-full border border-ink/20">
                  <button
                    type="button"
                    class="flex size-9 cursor-pointer items-center justify-center rounded-full transition hover:bg-soft"
                    data-quantity-step="down"
                    aria-label="{{ 'cart.decrease' | t }}"
                  >
                    {% render 'icon', name: 'minus', class: 'size-4' %}
                  </button>
                  <input
                    id="Quantity-{{ forloop.index }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    {% if max_quantity %}
                      max="{{ max_quantity }}"
                    {% endif %}
                    class="w-8 bg-transparent text-center text-sm [appearance:textfield] focus:outline-none [&::-webkit-inner-spin-button]:appearance-none"
                    data-cart-page-quantity
                    data-line="{{ forloop.index }}"
                  >
                  <button
                    type="button"
                    class="flex size-9 cursor-pointer items-center justify-center rounded-full transition hover:bg-soft disabled:cursor-not-allowed disabled:opacity-30"
                    data-quantity-step="up"
                    {% if max_quantity and item.quantity >= max_quantity %}
                      disabled
                    {% endif %}
                    aria-label="{{ 'cart.increase' | t }}"
                  >
                    {% render 'icon', name: 'plus', class: 'size-4' %}
                  </button>
                </div>
                <a href="{{ item.url_to_remove }}" data-cart-page-remove="{{ forloop.index }}" class="text-sm text-ink/60 underline underline-offset-4 hover:text-accent">
                  {{- 'cart.remove' | t -}}
                </a>
              </div>
              {%- if max_quantity and item.quantity >= max_quantity -%}
                <p class="mt-2 text-xs font-medium text-pink">{{ 'cart.max_reached' | t: count: max_quantity }}</p>
              {%- endif -%}
            </div>

            <p class="font-medium">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>

      <aside class="h-fit rounded-3xl bg-soft/60 p-6 md:p-8">
        {% render 'free-shipping-bar', class: 'mb-6 border-b border-ink/10 pb-6' %}
        <div class="flex justify-between text-lg font-medium">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="mt-1 text-xs text-ink/60">{{ 'cart.taxes' | t }}</p>

        <label for="CartNote" class="mt-6 block text-sm font-medium">{{ 'cart.note' | t }}</label>
        <textarea id="CartNote" name="note" rows="3" class="input mt-2 rounded-2xl">{{ cart.note }}</textarea>

        <button type="submit" name="checkout" class="btn mt-6 w-full py-4">{{ 'cart.checkout' | t }}</button>
        <button type="submit" name="update" class="btn-outline mt-3 w-full" data-cart-update>{{ 'cart.update' | t }}</button>

        {%- if additional_checkout_buttons -%}
          <div class="mt-3">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
      </aside>
    </form>
  {%- else -%}
    <div class="flex flex-col items-center gap-5 py-24 text-center">
      {% render 'icon', name: 'bag', class: 'size-14 text-accent' %}
      <p class="text-lg">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}
