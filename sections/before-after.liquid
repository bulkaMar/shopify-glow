<section class="bg-soft/60 py-14 md:py-24">
  <div class="page-width grid items-center gap-12 md:grid-cols-[2fr_3fr] md:gap-20">
    <div data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow mb-3">{% render 'tr', text: section.settings.eyebrow %}</p>
      {%- endif -%}
      <h2 class="text-4xl md:text-5xl">{% render 'tr', text: section.settings.heading %}</h2>
      {%- if section.settings.text != blank -%}
        <div class="rte mt-5 text-lg">{% render 'tr', text: section.settings.text %}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn mt-8">
          {%- render 'tr', text: section.settings.button_label %}
          {% render 'icon', name: 'arrow', class: 'size-4' -%}
        </a>
      {%- endif -%}
    </div>

    <div
      class="relative aspect-[4/3] overflow-hidden rounded-3xl bg-blush shadow-2xl shadow-accent/10 select-none"
      style="--position: 50%"
      data-compare
      data-reveal
    >
      <div class="absolute inset-0 bg-soft">
        {%- if section.settings.image_after != blank -%}
          {{ section.settings.image_after | image_url: width: 1400 | image_tag: class: 'h-full w-full object-cover', sizes: '(min-width: 768px) 60vw, 100vw', loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'h-full w-full' }}
        {%- endif -%}
      </div>

      <div class="absolute inset-0 bg-blush [clip-path:inset(0_calc(100%-var(--position))_0_0)]">
        {%- if section.settings.image_before != blank -%}
          {{ section.settings.image_before | image_url: width: 1400 | image_tag: class: 'h-full w-full object-cover', sizes: '(min-width: 768px) 60vw, 100vw', loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'h-full w-full' }}
        {%- endif -%}
      </div>

      <span class="pointer-events-none absolute top-4 left-4 rounded-full bg-paper/90 px-3 py-1 text-xs font-semibold tracking-wide uppercase backdrop-blur">{% render 'tr', text: section.settings.label_before %}</span>
      <span class="pointer-events-none absolute top-4 right-4 rounded-full bg-paper/90 px-3 py-1 text-xs font-semibold tracking-wide uppercase backdrop-blur">{% render 'tr', text: section.settings.label_after %}</span>

      <div class="pointer-events-none absolute inset-y-0 left-[var(--position)] w-0.5 -translate-x-1/2 bg-paper">
        <span class="absolute top-1/2 left-1/2 flex size-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-paper text-ink shadow-lg">
          {% render 'icon', name: 'arrows-horizontal', class: 'size-5' %}
        </span>
      </div>

      <input
        type="range"
        min="0"
        max="100"
        value="50"
        class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
        aria-label="{{ 'general.compare_slider' | t }}"
      >
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before / after",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above heading",
      "default": "Real results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the glow in 4 weeks"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Drag the slider to compare. Results after 28 days of using Hydra Glow Serum twice a day.</p>"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the serum"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Before / after"
    }
  ]
}
{% endschema %}
