{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="relative grid md:grid-cols-2" data-product data-quick-view-root>
  <button
    type="button"
    class="absolute top-4 right-4 z-10 flex size-10 cursor-pointer items-center justify-center rounded-full bg-paper/90 shadow-md backdrop-blur transition hover:rotate-90"
    data-quick-view-close
    aria-label="{{ 'general.close' | t }}"
  >
    {% render 'icon', name: 'close', class: 'size-5' %}
  </button>

  <div class="flex flex-col bg-soft">
    <div class="aspect-square md:aspect-auto md:min-h-0 md:flex-1" data-main-media>
      {%- assign main_media = current_variant.featured_media | default: product.featured_media -%}
      {%- if main_media -%}
        {{
          main_media
          | image_url: width: 1000
          | image_tag: class: 'h-full w-full object-cover', sizes: '(min-width: 768px) 30rem, 100vw', data-main-image: ''
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'h-full w-full' }}
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="flex gap-2 overflow-x-auto p-3">
        {%- for media in product.media limit: 6 -%}
          {%- if media.media_type == 'image' -%}
            <button
              type="button"
              class="size-14 shrink-0 cursor-pointer overflow-hidden rounded-xl border-2 border-transparent bg-paper transition hover:border-accent aria-[current=true]:border-ink"
              data-thumb="{{ media | image_url: width: 1000 }}"
              aria-current="{% if media.id == main_media.id %}true{% else %}false{% endif %}"
              aria-label="{{ media.alt | default: product.title | escape }}"
            >
              {{ media | image_url: width: 120 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy' }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="flex flex-col gap-5 p-6 md:p-10">
    <div class="pr-10">
      {%- if product.type != blank -%}
        <p class="eyebrow mb-2">{{ product.type }}</p>
      {%- endif -%}
      <h2 class="text-3xl leading-tight">{{ product.title }}</h2>

      {%- assign product_rating = product.metafields.reviews.rating.value -%}
      {%- if product_rating -%}
        <a href="{{ product.url }}#reviews" class="mt-2 inline-flex text-sm hover:text-accent">
          {% render 'rating-stars', rating: product_rating.rating, max: product_rating.scale_max, count: product.metafields.reviews.rating_count.value %}
        </a>
      {%- endif -%}

      <div class="mt-3 flex flex-wrap items-center gap-3 text-xl">
        <span data-price>{{ current_variant.price | money }}</span>
        <s
          class="text-base text-ink/50"
          data-compare-price
          {% unless current_variant.compare_at_price > current_variant.price %}
            hidden
          {% endunless %}
        >
          {{- current_variant.compare_at_price | money -}}
        </s>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          {%- assign saving = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span class="rounded-full bg-pink px-2.5 py-0.5 text-xs font-semibold text-white">-{{ saving }}%</span>
        {%- endif -%}
      </div>
    </div>

    {%- if product.description != blank -%}
      <p class="leading-relaxed text-ink/70">{{ product.description | strip_html | truncatewords: 35 }}</p>
    {%- endif -%}

    {%- if product.tags.size > 0 -%}
      <ul class="flex flex-wrap gap-2">
        {%- for tag in product.tags limit: 6 -%}
          {%- unless tag == 'bestseller' or tag == 'new' -%}
            <li class="rounded-full bg-blush px-3 py-1 text-xs capitalize">{{ tag }}</li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- form 'product', product, data-product-form: '' -%}
      {% render 'variant-picker', product: product, current_variant: current_variant, low_stock_threshold: 5 %}

      {%- liquid
        assign low_stock = ''
        if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5
          assign low_stock = 'products.low_stock' | t: count: current_variant.inventory_quantity
        endif
      -%}
      <p
        class="mb-4 flex items-center gap-2 text-sm font-semibold text-pink"
        data-low-stock
        {% if low_stock == blank %}
          hidden
        {% endif %}
      >
        <span class="relative flex size-2.5">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-pink opacity-60"></span>
          <span class="relative inline-flex size-2.5 rounded-full bg-pink"></span>
        </span>
        <span data-low-stock-text>{{ low_stock }}</span>
      </p>

      <div class="flex gap-3">
        <div class="flex items-center rounded-full border border-ink/20">
          <button
            type="button"
            class="flex size-10 cursor-pointer items-center justify-center rounded-full transition hover:bg-soft"
            data-quantity-step="down"
            aria-label="{{ 'cart.decrease' | t }}"
          >
            {% render 'icon', name: 'minus', class: 'size-4' %}
          </button>
          <input
            type="number"
            name="quantity"
            value="1"
            min="1"
            {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' %}
              max="{{ current_variant.inventory_quantity }}"
            {% endif %}
            class="w-7 bg-transparent text-center text-sm [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none"
            aria-label="{{ 'products.quantity' | t }}"
          >
          <button
            type="button"
            class="flex size-10 cursor-pointer items-center justify-center rounded-full transition hover:bg-soft"
            data-quantity-step="up"
            aria-label="{{ 'cart.increase' | t }}"
          >
            {% render 'icon', name: 'plus', class: 'size-4' %}
          </button>
        </div>

        <button
          type="submit"
          class="btn flex-1 py-3"
          data-add-button
          data-add-text="{{ 'products.add_to_cart' | t | escape }}"
          data-sold-out-text="{{ 'products.sold_out' | t | escape }}"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </button>
      </div>
      <p class="mt-3 rounded-xl bg-soft p-3 text-sm" role="alert" data-form-error hidden></p>
    {%- endform -%}

    <ul class="grid gap-3 rounded-2xl bg-soft/60 p-4 text-sm">
      {%- if settings.free_shipping_threshold > 0 -%}
        {%- assign shipping_amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
        <li class="flex items-center gap-3">
          {% render 'icon', name: 'truck', class: 'size-5 shrink-0 text-accent' %}
          {{ 'products.perk_shipping' | t: amount: shipping_amount }}
        </li>
      {%- endif -%}
      <li class="flex items-center gap-3">
        {% render 'icon', name: 'recycle', class: 'size-5 shrink-0 text-accent' %}
        {{ 'products.perk_returns' | t }}
      </li>
      <li class="flex items-center gap-3">
        {% render 'icon', name: 'rabbit', class: 'size-5 shrink-0 text-accent' %}
        {{ 'products.perk_clean' | t }}
      </li>
    </ul>

    <a href="{{ product.url }}" class="group mt-auto inline-flex items-center gap-2 text-sm font-medium hover:text-accent">
      {{- 'products.view_details' | t }}
      {% render 'icon', name: 'arrow', class: 'size-4 transition group-hover:translate-x-1' %}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Quick view",
  "settings": []
}
{% endschema %}
