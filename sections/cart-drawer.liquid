<dialog
  class="m-0 ml-auto h-dvh max-h-dvh w-full max-w-full bg-paper sm:max-w-md p-0 text-ink backdrop:bg-ink/40 open:flex open:flex-col"
  aria-label="{{ 'cart.title' | t }}"
  data-cart-drawer
>
  <div class="flex h-full flex-col" data-cart-drawer-content data-item-count="{{ cart.item_count }}">
    <div class="flex items-center justify-between border-b border-ink/10 px-5 py-3.5 sm:px-6 sm:py-5">
      <h2 class="flex items-center gap-2 text-xl sm:text-2xl">
        {{ 'cart.title' | t }}
        {%- if cart.item_count > 0 -%}
          <span class="flex h-6 min-w-6 items-center justify-center rounded-full bg-soft px-2 font-sans text-xs font-semibold text-accent">{{ cart.item_count }}</span>
        {%- endif -%}
      </h2>
      <button type="button" class="-mr-2 cursor-pointer p-2" data-cart-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close', class: 'size-6' %}
      </button>
    </div>

    {%- if cart.item_count > 0 -%}
      {% render 'free-shipping-bar', class: 'border-b border-ink/10 bg-soft/40 px-5 py-3 sm:px-6 sm:py-4' %}
      <div class="flex-1 overflow-y-auto">
        <ul class="divide-y divide-ink/10 px-5 sm:px-6">
          {%- for item in cart.items -%}
            {%- liquid
              assign max_quantity = nil
              if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny'
                assign max_quantity = item.variant.inventory_quantity
              endif
            -%}
            <li class="flex gap-4 py-4 sm:py-5">
              <a href="{{ item.url }}" class="size-20 shrink-0 overflow-hidden rounded-xl bg-soft">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 160 | image_tag: class: 'h-full w-full object-cover', loading: 'lazy' }}
                {%- endif -%}
              </a>

              <div class="flex flex-1 flex-col">
                <div class="flex justify-between gap-3">
                  <a href="{{ item.url }}" class="text-sm font-medium hover:text-accent">{{ item.product.title }}</a>
                  <p class="text-sm">{{ item.final_line_price | money }}</p>
                </div>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="mt-1 text-xs text-ink/60">{{ item.variant.title }}</p>
                {%- endunless -%}

                <div class="mt-auto flex items-center justify-between pt-3">
                  <div class="flex items-center rounded-full border border-ink/20">
                    <button
                      type="button"
                      class="flex size-8 cursor-pointer items-center justify-center"
                      data-cart-line="{{ forloop.index }}"
                      data-cart-quantity="{{ item.quantity | minus: 1 }}"
                      aria-label="{{ 'cart.decrease' | t }}"
                    >
                      {% render 'icon', name: 'minus', class: 'size-4' %}
                    </button>
                    <span class="w-6 text-center text-sm">{{ item.quantity }}</span>
                    <button
                      type="button"
                      class="flex size-8 cursor-pointer items-center justify-center disabled:cursor-not-allowed disabled:opacity-30"
                      data-cart-line="{{ forloop.index }}"
                      data-cart-quantity="{{ item.quantity | plus: 1 }}"
                      {% if max_quantity and item.quantity >= max_quantity %}
                        disabled
                      {% endif %}
                      aria-label="{{ 'cart.increase' | t }}"
                    >
                      {% render 'icon', name: 'plus', class: 'size-4' %}
                    </button>
                  </div>
                  <button
                    type="button"
                    class="cursor-pointer text-xs text-ink/60 underline underline-offset-4 hover:text-accent"
                    data-cart-line="{{ forloop.index }}"
                    data-cart-quantity="0"
                  >
                    {{ 'cart.remove' | t }}
                  </button>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div
          class="border-t border-ink/10 bg-soft/30"
          data-cart-recommendations
          data-url="{{ routes.product_recommendations_url }}?product_id={{ cart.items.first.product_id }}&limit=10&section_id=cart-recommendations"
        ></div>
      </div>

      <div class="border-t border-ink/10 px-5 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] shadow-[0_-8px_24px_rgb(0_0_0/0.04)] sm:px-6 sm:py-6">
        <div class="flex items-baseline justify-between gap-4">
          <div>
            <p class="font-medium">{{ 'cart.subtotal' | t }}</p>
            <p class="text-xs text-ink/50">{{ 'cart.taxes' | t }}</p>
          </div>
          <p class="text-lg font-semibold">{{ cart.total_price | money }}</p>
        </div>
        <div class="mt-4 flex items-center gap-3 sm:mt-5 sm:flex-col sm:items-stretch">
          <a href="{{ routes.cart_url }}" class="btn-outline shrink-0 px-5 py-3 sm:order-last sm:border-0 sm:bg-transparent sm:p-0 sm:font-normal sm:underline sm:underline-offset-4 sm:before:hidden sm:hover:translate-y-0 sm:hover:text-ink">
            {{- 'cart.view_cart' | t -}}
          </a>
          <form action="{{ routes.cart_url }}" method="post" class="flex-1">
            <button type="submit" name="checkout" class="btn w-full py-3 sm:py-3.5">{{ 'cart.checkout' | t }}</button>
          </form>
        </div>
      </div>
    {%- else -%}
      <div class="flex flex-1 flex-col overflow-y-auto">
        <div class="flex flex-1 flex-col items-center justify-center gap-5 px-6 py-10 text-center">
          <span class="flex size-20 items-center justify-center rounded-full bg-soft text-accent">
            {% render 'icon', name: 'bag', class: 'size-9' %}
          </span>
          <p class="text-lg">{{ 'cart.empty' | t }}</p>
          {%- if settings.free_shipping_threshold > 0 -%}
            {%- assign free_from = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
            <p class="-mt-3 flex items-center gap-2 text-sm text-ink/60">
              {% render 'icon', name: 'truck', class: 'size-4 text-accent' %}
              {{ 'products.perk_shipping' | t: amount: free_from }}
            </p>
          {%- endif -%}
          <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue' | t }}</a>
        </div>
        <div
          class="border-t border-ink/10 bg-soft/30"
          data-cart-recommendations
          data-url="{{ routes.root_url | append: '?section_id=cart-recommendations' | replace: '//', '/' }}"
        ></div>
      </div>
    {%- endif -%}
  </div>
</dialog>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
