<header class="sticky top-0 z-30 border-b border-ink/10 bg-paper/90 backdrop-blur">
  <div class="page-width flex h-16 items-center justify-between gap-6 md:h-20">
    <div class="flex items-center gap-2">
      <details class="md:hidden">
        <summary class="-ml-2 flex cursor-pointer list-none p-2" aria-label="{{ 'general.menu' | t }}">
          {% render 'icon', name: 'menu', class: 'size-6' %}
        </summary>
        <nav class="absolute inset-x-0 top-full h-[calc(100dvh-4rem)] overflow-y-auto border-t border-ink/10 bg-paper px-6 py-8">
          <ul class="flex flex-col gap-5">
            {%- for link in section.settings.menu.links -%}
              <li>
                <a href="{{ link.url }}" class="font-heading text-2xl">{{ link.title }}</a>
                {%- if link.links.size > 0 -%}
                  <ul class="mt-3 flex flex-col gap-2 pl-4">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}" class="text-ink/70">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </details>

      <a href="{{ routes.root_url }}" class="block" aria-label="{{ shop.name }}">
        {%- if settings.logo != blank -%}
          {%- assign logo_style = '--logo-width: ' | append: settings.logo_width | append: 'px' -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'h-auto w-(--logo-width)',
              style: logo_style,
              alt: shop.name,
              widths: '150, 300, 600',
              loading: 'eager'
          }}
        {%- else -%}
          {% render 'logo', id: 'header', class: 'text-2xl md:text-3xl' %}
        {%- endif -%}
      </a>
    </div>

    <nav class="hidden md:block" aria-label="{{ 'general.menu' | t }}">
      <ul class="flex items-center gap-8">
        {%- for link in section.settings.menu.links -%}
          <li class="group relative">
            <a
              href="{{ link.url }}"
              class="flex items-center gap-1 py-2 text-sm font-medium transition hover:text-accent {% if link.active %}text-accent{% endif %}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title -}}
              {%- if link.links.size > 0 %}{% render 'icon', name: 'chevron', class: 'size-4' %}{% endif -%}
            </a>

            {%- if link.links.size > 0 -%}
              <ul class="invisible absolute top-full left-1/2 min-w-52 -translate-x-1/2 rounded-2xl bg-white p-3 opacity-0 shadow-xl transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                {%- for child in link.links -%}
                  <li>
                    <a href="{{ child.url }}" class="block rounded-xl px-4 py-2 text-sm hover:bg-soft">{{ child.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="-mr-2 flex items-center">
      <div class="lg:mr-2">
        {% render 'language-switcher' %}
      </div>
      <a href="{{ routes.search_url }}" class="p-2 hover:text-accent" data-search-open aria-label="{{ 'general.search' | t }}">
        {% render 'icon', name: 'search', class: 'size-6' %}
      </a>
      <a href="{{ routes.cart_url }}" class="relative p-2 hover:text-accent" data-cart-open aria-label="{{ 'general.cart' | t }}">
        {% render 'icon', name: 'bag', class: 'size-6' %}
        <span
          class="absolute top-0 right-0 flex size-5 items-center justify-center rounded-full bg-pink text-[11px] font-semibold text-white"
          data-cart-count
          {% if cart.item_count == 0 %}
            hidden
          {% endif %}
        >
          {{- cart.item_count -}}
        </span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
