{%- paginate search.results by 12 -%}
  <div class="page-width py-10 md:py-16">
    <h1 class="text-center text-4xl md:text-5xl">{{ 'search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="mx-auto mt-8 flex max-w-xl gap-2">
      <input type="hidden" name="options[prefix]" value="last">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        class="input"
        aria-label="{{ 'search.placeholder' | t }}"
      >
      <button type="submit" class="btn shrink-0" aria-label="{{ 'general.search' | t }}">
        {% render 'icon', name: 'search' %}
      </button>
    </form>

    {%- if search.performed -%}
      <p class="mt-8 text-center text-sm text-ink/70">
        {%- if search.results_count > 0 -%}
          {{ 'search.results' | t: count: search.results_count, terms: search.terms }}
        {%- else -%}
          {{ 'search.no_results' | t: terms: search.terms }}
        {%- endif -%}
      </p>

      <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 lg:grid-cols-4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item, show_quick_add: true %}
          {%- else -%}
            <a href="{{ item.url }}" class="flex flex-col rounded-2xl bg-soft/60 p-6 hover:bg-soft">
              <span class="eyebrow">{{ item.object_type }}</span>
              <span class="mt-3 font-heading text-xl">{{ item.title }}</span>
              <span class="mt-2 text-sm text-ink/70">{{ item.content | strip_html | truncatewords: 15 }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
