{%- liquid
  assign total = 0
  for block in section.blocks
    assign total = total | plus: block.settings.rating
  endfor

  assign average = product.metafields.reviews.rating.value.rating
  assign review_count = product.metafields.reviews.rating_count.value
  if average == blank and section.blocks.size > 0
    assign average = total | times: 1.0 | divided_by: section.blocks.size | round: 1
    assign review_count = section.blocks.size
  endif
-%}

<section id="reviews" class="page-width scroll-mt-24 py-14 md:py-20">
  <div class="flex flex-col gap-6 border-b border-ink/10 pb-10 md:flex-row md:items-end md:justify-between" data-reveal>
    <div>
      <p class="eyebrow mb-2">{% render 'tr', text: section.settings.eyebrow %}</p>
      <h2 class="text-4xl md:text-5xl">{% render 'tr', text: section.settings.heading %}</h2>
    </div>

    {%- assign dialog_id = 'ReviewDialog-' | append: section.id -%}
    <div class="flex flex-wrap items-center gap-6">
      {%- if average -%}
        <div class="flex items-center gap-4">
          <p class="font-heading text-6xl leading-none">{{ average | times: 1.0 | round: 1 }}</p>
          <div>
            {% render 'rating-stars', rating: average, class: 'text-xl' %}
            <p class="mt-1 text-sm text-ink/60">{{ 'products.reviews' | t: count: review_count }}</p>
          </div>
        </div>
      {%- endif -%}
      <button type="button" class="btn-outline px-5 py-2.5" data-dialog-open="{{ dialog_id }}">
        {% render 'icon', name: 'plus', class: 'size-4' %}
        {{ 'reviews.write' | t }}
      </button>
    </div>
  </div>

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    {%- for block in section.blocks -%}
      <article
        class="rounded-3xl border border-ink/10 bg-paper p-6 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink/5 md:p-8"
        style="--reveal-delay: {{ forloop.index0 | modulo: 2 | times: 120 }}ms"
        data-reveal
        {{ block.shopify_attributes }}
      >
        <div class="flex items-center justify-between gap-4">
          {% render 'rating-stars', rating: block.settings.rating %}
          {%- if block.settings.skin_type != blank -%}
            <span class="rounded-full bg-soft px-3 py-1 text-xs">{% render 'tr', text: block.settings.skin_type %}</span>
          {%- endif -%}
        </div>
        <h3 class="mt-4 font-sans text-lg font-semibold">{% render 'tr', text: block.settings.title %}</h3>
        <p class="mt-2 leading-relaxed text-ink/70">{% render 'tr', text: block.settings.text %}</p>
        <div class="mt-6 flex items-center gap-3 text-sm">
          <span class="flex size-9 items-center justify-center rounded-full bg-blush font-semibold text-pink">
            {{- block.settings.author | slice: 0 -}}
          </span>
          <span class="font-medium">{{ block.settings.author }}</span>
          <span class="flex items-center gap-1 text-xs text-ink/50">
            {% render 'icon', name: 'check', class: 'size-3.5 text-accent' %}
            {{ 'products.verified_buyer' | t }}
          </span>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% render 'review-dialog', dialog_id: dialog_id, product: product %}

{% schema %}
{
  "name": "Product reviews",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by real skin"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Anna K."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Holy grail serum"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "My skin feels plump and hydrated all day."
        },
        {
          "type": "text",
          "id": "skin_type",
          "label": "Skin type",
          "default": "Dry skin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product reviews",
      "blocks": [{ "type": "review" }, { "type": "review" }]
    }
  ]
}
{% endschema %}
