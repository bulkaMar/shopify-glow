{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>

    {% render 'theme-styles' %}

    {{ content_for_header }}
  </head>

  <body class="flex min-h-screen items-center justify-center bg-soft p-4">
    <main class="w-full max-w-md rounded-3xl bg-paper p-8 text-center shadow-xl md:p-12">
      <p>{% render 'logo', id: 'gift-card', class: 'text-3xl' %}</p>

      <p class="eyebrow mt-10">{{ 'gift_card.title' | t }}</p>
      <p class="mt-3 font-heading text-6xl">{{ gift_card.balance | money }}</p>

      {%- if gift_card.expired or gift_card.enabled == false -%}
        <p class="mt-4 text-sm text-accent">{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}

      <p class="mt-8 rounded-full border border-dashed border-ink/30 px-4 py-3 font-mono tracking-widest">
        {{- gift_card.code | format_code -}}
      </p>

      <a href="{{ shop.url }}" class="btn mt-8 w-full">{{ 'gift_card.shop' | t }}</a>
    </main>
  </body>
</html>
