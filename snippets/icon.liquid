      <path d="M14 3v11.5a3.5 3.5 0 11-3.5-3.5"/><path d="M14 3c.5 2.5 2.5 4.5 5 4.5"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14z"/><path d="M5 19l8-8"/>
    {%- when 'rabbit' -%}
      <path d="M9.3 10.6C7.6 7.8 7.2 3.6 8.6 3.1c1.5-.5 2.8 3.4 3.1 6.9"/><path d="M14.7 10.6c1.7-2.8 2.1-7 .7-7.5-1.5-.5-2.8 3.4-3.1 6.9"/><path d="M6 15.6C6 12.4 8.7 10 12 10s6 2.4 6 5.6-2.7 5.4-6 5.4-6-2.2-6-5.4z"/><circle cx="9.8" cy="15" r=".7" fill="currentColor"/><circle cx="14.2" cy="15" r=".7" fill="currentColor"/><path d="M11.2 17.4l.8.6.8-.6"/>
    {%- when 'flask' -%}
