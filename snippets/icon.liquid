    {%- when 'bag' -%}
      <path d="M5.5 8h13l-1 12h-11l-1-12z"/><path d="M9 8V7a3 3 0 016 0v1"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'chevron' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
