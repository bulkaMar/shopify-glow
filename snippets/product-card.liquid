<div class="group flex flex-col">
  {%- liquid
    assign card_images = 0
    for media in product.media limit: 5
      if media.media_type == 'image'
        assign card_images = card_images | plus: 1
      endif
    endfor
  -%}
  <div class="relative" data-card-gallery>
    <a href="{{ product.url }}" class="relative block aspect-[4/5] overflow-hidden rounded-2xl bg-soft" tabindex="-1">
      {%- if product.featured_media -%}
        <span
          class="absolute inset-0 flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] md:block md:snap-none md:overflow-visible md:transition md:duration-700 md:group-hover:scale-105 [&::-webkit-scrollbar]:hidden"
          data-card-track
        >
          {%- assign image_index = 0 -%}
          {%- for media in product.media limit: 5 -%}
            {%- if media.media_type == 'image' -%}
              {%- liquid
                assign image_class = 'h-full w-full shrink-0 snap-center object-cover md:absolute md:inset-0 md:transition-opacity md:duration-500'
                if image_index == 0
                  assign image_class = image_class | append: ' md:opacity-100'
                else
                  assign image_class = image_class | append: ' md:opacity-0'
                endif
              -%}
              {{
                media
                | image_url: width: 800
                | image_tag:
                  class: image_class,
                  widths: '300, 400, 600, 800',
                  sizes: '(min-width: 1024px) 25vw, 50vw',
                  loading: 'lazy',
                  data-card-image: image_index
              }}
              {%- assign image_index = image_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </span>
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'h-full w-full' }}
      {%- endif -%}
    </a>

    {%- if card_images > 1 -%}
      <div class="pointer-events-none absolute inset-x-3 top-2 flex gap-1 transition duration-300 md:opacity-0 md:group-hover:opacity-100" aria-hidden="true">
        {%- for i in (1..card_images) -%}
          <span class="h-0.5 flex-1 rounded-full {% if forloop.first %}bg-paper{% else %}bg-paper/40{% endif %} transition-colors" data-card-dot></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="pointer-events-none absolute top-4 left-3 rounded-full bg-ink px-3 py-1 text-xs font-semibold text-paper">
        {{- 'products.sold_out' | t -}}
      </span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="pointer-events-none absolute top-4 left-3 rounded-full bg-pink px-3 py-1 text-xs font-semibold text-white">
        {{- 'products.on_sale' | t -}}
      </span>
    {%- endif -%}

    <button
      type="button"
      class="absolute inset-x-3 bottom-3 hidden cursor-pointer items-center justify-center gap-2 rounded-full bg-paper/90 py-2.5 text-sm font-semibold opacity-0 shadow-lg backdrop-blur transition duration-300 md:group-hover:translate-y-0 group-hover:opacity-100 hover:bg-ink hover:text-paper focus-visible:opacity-100 md:flex md:translate-y-2"
      data-quick-view="{{ product.url }}"
    >
      {% render 'icon', name: 'eye', class: 'size-4' %}
      {{ 'products.quick_view' | t }}
    </button>
  </div>

  <div class="mt-4 flex flex-1 flex-col gap-1">
    <h3 class="font-sans text-base font-medium">
      <a href="{{ product.url }}" class="hover:text-accent">{{ product.title }}</a>
    </h3>
    {%- assign product_rating = product.metafields.reviews.rating.value -%}
    {%- if product_rating -%}
      {% render 'rating-stars', rating: product_rating.rating, max: product_rating.scale_max, count: product.metafields.reviews.rating_count.value, class: 'text-xs' %}
    {%- endif -%}
    {% render 'price', product: product, class: 'text-sm' %}

    {%- if show_quick_add and product.available -%}
      <div class="mt-3">
        {%- if product.has_only_default_variant -%}
          {%- form 'product', product, data-product-form: '' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="btn-outline w-full py-2.5">{{ 'products.add_to_cart' | t }}</button>
            <p class="mt-2 text-xs text-accent" data-form-error hidden></p>
          {%- endform -%}
        {%- else -%}
          <a href="{{ product.url }}" class="btn-outline w-full py-2.5">{{ 'products.choose_options' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
